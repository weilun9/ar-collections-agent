# 复制为 .env 并填入真实凭据。
#
# 重要：填了凭据也不会自动生效 —— 还需要同时满足
#   1) config.json 里对应渠道 "live": true
#   2) 环境变量 AR_LIVE=1
# 双重闸门，防止误改配置文件就把消息发给真实客户。
#
# PowerShell 里临时开启实发：
#   $env:AR_LIVE="1"; python ar.py scan

# ---- WhatsApp Business（Meta Cloud API）· 对客户 ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ---- Gmail（SMTP + 应用专用密码）· 对客户 & 对内 ----
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Slack · 只对内 ----
# 二选一：Webhook 最简单，Bot Token 支持发到指定频道/私聊
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# ---- Google Sheets（替代 CSV 存储，可选）----
# 需先 pip install google-api-python-client google-auth
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ---- LLM（只用于高风险告警的沟通历史摘要，可选）----
# none（默认，确定性清单）| ollama（本地，免费）| anthropic
AR_LLM_PROVIDER=
AR_LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
