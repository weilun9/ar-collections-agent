# Copy to .env and fill in real credentials.
#
# Important: credentials alone do not switch anything on. Both of these are also required:
#   1) "live": true for that channel in config.json
#   2) the environment variable AR_LIVE=1
# Two gates, so a mistaken config edit cannot send messages to real customers.
#
# To enable live sending temporarily in PowerShell:
#   $env:AR_LIVE="1"; python ar.py scan

# ---- WhatsApp Business (Meta Cloud API) · to customers ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ---- Gmail (SMTP + app password) · to customers & internal ----
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Slack · internal only ----
# Pick one: a webhook is simplest; a bot token can post to a given channel or DM
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# ---- Google Sheets (optional, replaces the CSV store) ----
# Needs: pip install google-api-python-client google-auth
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ---- LLM (optional; only used for the contact-history summary in high-risk alerts) ----
# none (default, deterministic list) | ollama (local, free) | anthropic
AR_LLM_PROVIDER=
AR_LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
